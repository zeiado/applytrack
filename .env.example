APPLYTRACK_ENVIRONMENT=local
APPLYTRACK_LOG_LEVEL=INFO
# auto = JSON lines in production, readable text otherwise
APPLYTRACK_LOG_FORMAT=auto
APPLYTRACK_DATABASE_URL=postgresql+psycopg://applytrack:applytrack@localhost:5432/applytrack
# Required in production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPLYTRACK_JWT_SECRET_KEY=
APPLYTRACK_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Failed-login rate limits (ADR 0005)
APPLYTRACK_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
APPLYTRACK_LOGIN_MAX_FAILURES_PER_IP=20
APPLYTRACK_LOGIN_WINDOW_SECONDS=60
# Reverse proxies in front of the app that append to X-Forwarded-For, so login rate limits
# and logs see the real client IP. 0 = no proxy. Don't also set uvicorn's FORWARDED_ALLOW_IPS.
APPLYTRACK_TRUSTED_PROXY_HOPS=0

# The web app; links in emails point here
APPLYTRACK_PUBLIC_APP_URL=http://localhost:3000
# One-time email links (docs/adr/0008-one-time-email-tokens.md)
APPLYTRACK_EMAIL_VERIFICATION_EXPIRE_HOURS=24
APPLYTRACK_PASSWORD_RESET_EXPIRE_MINUTES=30
# Password reset requests per IP per hour, whatever the email
APPLYTRACK_FORGOT_PASSWORD_MAX_PER_IP=10
# Emails of each kind (verification, password reset) per account per hour
APPLYTRACK_EMAIL_TOKEN_LIMIT_PER_HOUR=3

# Shared with the web app's server (API_PROXY_SECRET there), so rate limits apply per
# visitor. 32+ characters. Empty = X-Client-IP is ignored.
APPLYTRACK_CLIENT_IP_SECRET=

# Sign in with Google: OAuth client IDs, comma-separated (docs/deployment.md). Empty = off.
APPLYTRACK_GOOGLE_CLIENT_IDS=

# Daily follow-up reminder emails: from this local hour, checked every N minutes
APPLYTRACK_REMINDER_HOUR=8
APPLYTRACK_REMINDER_CHECK_MINUTES=5

# Email (docs/adr/0007-database-job-queue-and-email.md)
# console = write emails to the log, send nothing. resend or smtp to really send.
APPLYTRACK_EMAIL_BACKEND=console
# Must be on your verified sending domain for resend/smtp
APPLYTRACK_EMAIL_FROM=ApplyTrack <noreply@localhost>
APPLYTRACK_EMAIL_REPLY_TO=
APPLYTRACK_EMAIL_TIMEOUT_SECONDS=10
# resend: an API key from resend.com
APPLYTRACK_RESEND_API_KEY=
# smtp: any provider (Postmark, Brevo, Amazon SES, Mailgun...). security: starttls, tls or none
APPLYTRACK_SMTP_HOST=
APPLYTRACK_SMTP_PORT=587
APPLYTRACK_SMTP_USERNAME=
APPLYTRACK_SMTP_PASSWORD=
APPLYTRACK_SMTP_SECURITY=starttls

# Background jobs. Run the worker with `make worker` (or the compose `worker` service),
# or set this to true to run it inside the API process instead.
APPLYTRACK_RUN_WORKER_IN_API=false
APPLYTRACK_WORKER_POLL_SECONDS=2
APPLYTRACK_JOB_MAX_ATTEMPTS=5

# Uploaded CVs (docs/adr/0011-object-storage-for-cvs.md). Either a local folder for
# development, or an S3-compatible bucket (Cloudflare R2). Neither: uploads are off.
APPLYTRACK_STORAGE_LOCAL_DIR=.storage
APPLYTRACK_STORAGE_ENDPOINT=
APPLYTRACK_STORAGE_BUCKET=
APPLYTRACK_STORAGE_ACCESS_KEY_ID=
APPLYTRACK_STORAGE_SECRET_ACCESS_KEY=

# Error tracking and product analytics (docs/privacy.md). Leave empty to turn them off.
APPLYTRACK_SENTRY_DSN=
APPLYTRACK_POSTHOG_API_KEY=
APPLYTRACK_POSTHOG_HOST=https://eu.i.posthog.com
