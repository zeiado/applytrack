# The API (server-side only; the browser never calls it directly)
API_URL=http://localhost:8000
# Shared with the API (its APPLYTRACK_CLIENT_IP_SECRET), so rate limits apply per
# visitor. Leave empty locally.
API_PROXY_SECRET=
# Google OAuth client ID; empty hides the Google button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The product name shown in the app
NEXT_PUBLIC_APP_NAME=Sekka
# The address for questions about data and the terms, shown on /privacy and /terms;
# empty points people to settings instead
NEXT_PUBLIC_CONTACT_EMAIL=
# The public address, for the sitemap. Empty = the Vercel production domain, else localhost
NEXT_PUBLIC_SITE_URL=
# The extension's Chrome Web Store page, for the first-run guide; empty hides that step
NEXT_PUBLIC_EXTENSION_URL=
# A short feedback form (https only, for example Tally); empty hides the feedback links
NEXT_PUBLIC_FEEDBACK_URL=
# Sentry error reports, without personal data (docs/privacy.md); empty turns them off
NEXT_PUBLIC_SENTRY_DSN=
# The browser extension's id(s) in the Chrome Web Store, comma-separated. Empty accepts
# any extension (development); see extension/README.md
EXTENSION_IDS=
